# =============================================================================
# Frontend environment template. Copy to .env for local development.
#
# Only NEXT_PUBLIC_* values reach the browser, so nothing secret may live there.
# The gateway URL below is used by server components and route handlers; the
# browser never talks to the gateway directly and never holds a token.
# =============================================================================

# Where the Next.js server reaches Kong. Leave this UNSET so each run mode picks
# its own working default:
#   docker compose -> http://host.docker.internal:8000 (from docker-compose.yml,
#                     paired with the extra_hosts host-gateway mapping)
#   npm run dev     -> http://localhost:8000 (fallback in apps/*/src/lib/env.ts)
# Compose interpolates this file, so setting it here applies to BOTH modes and
# breaks whichever one it does not suit. Only set it to reach a remote gateway.
# API_GATEWAY_URL=http://localhost:8000

# Browser-visible values only. Never place a credential here.
NEXT_PUBLIC_SITE_NAME=BD Shop
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100
NEXT_PUBLIC_CURRENCY=BDT

# Delivery terms shown in the shop. These are display values: checkout charges
# whatever the admin service is configured with (SHIPPING_FLAT_RATE and
# FREE_SHIPPING_THRESHOLD in the backend env), so keep the two in step.
NEXT_PUBLIC_DELIVERY_FLAT_RATE=120
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=5000

# ---- Brand -------------------------------------------------------------------
# Logo: a path under an app's public/ directory, or an absolute https URL.
# Leave NEXT_PUBLIC_SITE_LOGO empty to show the site name as a wordmark instead.
# Width/height are the asset's intrinsic pixels - they reserve space and stop the
# header shifting as the image loads. Set _WITH_NAME=true to show the wordmark
# beside the logo, which suits an icon-only mark.
NEXT_PUBLIC_SITE_LOGO=
NEXT_PUBLIC_SITE_LOGO_WIDTH=120
NEXT_PUBLIC_SITE_LOGO_HEIGHT=32
NEXT_PUBLIC_SITE_LOGO_WITH_NAME=false

# ---- Owner -------------------------------------------------------------------
# Shown small in the storefront footer and on both sign-in pages. Clearing
# NEXT_PUBLIC_OWNER_NAME hides it everywhere. Until the image file is in place a
# neat initials circle stands in, so nothing looks broken.
# The portrait must be saved into BOTH apps (each Next app serves its own public/):
#   apps/public/public/brand/owner.jpg
#   apps/admin/public/brand/owner.jpg
# Square crop, 320x320 or larger, eye-level - it renders at 36-56px.
NEXT_PUBLIC_OWNER_NAME=Site Owner
NEXT_PUBLIC_OWNER_ROLE=Founder
# Leave empty until the portrait is saved in both apps (paths above): an initials
# circle stands in. Then set this to /brand/owner.jpg and rebuild.
NEXT_PUBLIC_OWNER_IMAGE=

# Session cookies issued by the Next.js backend-for-frontend.
SESSION_COOKIE_NAME=aurelia_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

# Ports
STOREFRONT_PORT=3000
ADMIN_PORT=3100
