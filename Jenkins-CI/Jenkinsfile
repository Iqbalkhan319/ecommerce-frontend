pipeline {
  agent any

  options {
    disableConcurrentBuilds()
  }

  environment {
    REGISTRY = 'nuruzzaman24x'
    TAG      = "b${env.BUILD_NUMBER}"
    REPO_URL = 'github.com/nuruzzaman24x/ecommerce-frontend.git'
  }

  stages {
    stage('Build storefront') {
      steps {
        sh '''
          docker build -f apps/public/Dockerfile --target runtime \
            --build-arg NEXT_PUBLIC_SITE_NAME="BD Shop" \
            --build-arg NEXT_PUBLIC_SITE_URL="http://shop.local" \
            --build-arg NEXT_PUBLIC_ADMIN_URL="http://admin.local" \
            --build-arg NEXT_PUBLIC_CURRENCY="BDT" \
            -t $REGISTRY/ecom-storefront:$TAG .
        '''
      }
    }

    stage('Build admin-ui') {
      steps {
        sh '''
          docker build -f apps/admin/Dockerfile --target runtime \
            --build-arg NEXT_PUBLIC_SITE_NAME="BD Shop" \
            --build-arg NEXT_PUBLIC_SITE_URL="http://shop.local" \
            --build-arg NEXT_PUBLIC_CURRENCY="BDT" \
            --build-arg NEXT_PUBLIC_DELIVERY_FLAT_RATE="120" \
            -t $REGISTRY/ecom-admin-ui:$TAG .
        '''
      }
    }

    stage('SonarQube scan') {
      steps {
        withCredentials([string(credentialsId: 'ecom-sonar-token', variable: 'SONAR_TOKEN')]) {
          sh '''
            docker run --rm \
              -e SONAR_TOKEN \
              --add-host sonar.local:172.17.0.14 -e SONAR_HOST_URL="http://sonar.local" \
              -v "$WORKSPACE":/usr/src \
              sonarsource/sonar-scanner-cli:latest \
              -Dsonar.projectKey=ecom-frontend \
              -Dsonar.sources=apps,packages \
              -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/.next/**" \
              -Dsonar.javascript.node.timeout=600000 \
              -Dsonar.ws.timeout=600 \
              -Dsonar.working.directory=/tmp/.scannerwork
          '''
        }
      }
    }

    stage('Security scan (Trivy)') {
      steps {
        sh '''
          for img in ecom-storefront ecom-admin-ui; do
            echo "===== Trivy scan: $img:$TAG ====="
            docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache/ aquasec/trivy:0.71.2 image --severity HIGH --ignore-unfixed --exit-code 0 --no-progress $REGISTRY/$img:$TAG
            docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache/ aquasec/trivy:0.71.2 image --severity CRITICAL --ignore-unfixed --exit-code 1 --no-progress $REGISTRY/$img:$TAG
          done
        '''
      }
    }

    stage('Push to Docker Hub') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'ecom-dockerhub',
                                          usernameVariable: 'DH_USER',
                                          passwordVariable: 'DH_PASS')]) {
          sh '''
            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
            docker push $REGISTRY/ecom-storefront:$TAG
            docker push $REGISTRY/ecom-admin-ui:$TAG
            docker logout
          '''
        }
      }
    }

    stage('Update manifest in git') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'ecom-github',
                                          usernameVariable: 'GH_USER',
                                          passwordVariable: 'GH_PASS')]) {
          sh '''
            sed -i "s|image: $REGISTRY/ecom-storefront:.*|image: $REGISTRY/ecom-storefront:$TAG|" k8s-manifest/frontend/storefront.yaml
            sed -i "s|image: $REGISTRY/ecom-admin-ui:.*|image: $REGISTRY/ecom-admin-ui:$TAG|" k8s-manifest/frontend/admin-ui.yaml
            grep -n "image:" k8s-manifest/frontend/storefront.yaml k8s-manifest/frontend/admin-ui.yaml

            git config user.email "jenkins@local"
            git config user.name "jenkins"
            git add k8s-manifest/frontend/
            git commit -m "ci: deploy $TAG [skip ci]"
            git push https://$GH_USER:$GH_PASS@$REPO_URL HEAD:main
          '''
        }
      }
    }

  }
}
