pipeline {
  agent any

  options {
    disableConcurrentBuilds()
  }

  environment {
    REGISTRY = 'nuruzzaman24x'
    TAG      = "b${env.BUILD_NUMBER}"
    REPO_URL = 'github.com/nuruzzaman24x/ecommerce-frontend.git'
  }

  stages {
    stage('Build storefront') {
      steps {
        sh '''
          docker build -f apps/public/Dockerfile --target runtime \
            --build-arg NEXT_PUBLIC_SITE_NAME="BD Shop" \
            --build-arg NEXT_PUBLIC_SITE_URL="http://172.17.0.233:30000" \
            --build-arg NEXT_PUBLIC_ADMIN_URL="http://172.17.0.233:30100" \
            --build-arg NEXT_PUBLIC_CURRENCY="BDT" \
            -t $REGISTRY/ecom-storefront:$TAG .
        '''
      }
    }

    stage('Build admin-ui') {
      steps {
        sh '''
          docker build -f apps/admin/Dockerfile --target runtime \
            --build-arg NEXT_PUBLIC_SITE_NAME="BD Shop" \
            --build-arg NEXT_PUBLIC_SITE_URL="http://172.17.0.233:30000" \
            --build-arg NEXT_PUBLIC_CURRENCY="BDT" \
            --build-arg NEXT_PUBLIC_DELIVERY_FLAT_RATE="120" \
            -t $REGISTRY/ecom-admin-ui:$TAG .
        '''
      }
    }

    stage('Security scan (Trivy)') {
      steps {
        sh '''
          for img in ecom-storefront ecom-admin-ui; do
            echo "===== Trivy scan: $img:$TAG ====="
            trivy image --severity HIGH --ignore-unfixed --exit-code 0 --no-progress $REGISTRY/$img:$TAG
            trivy image --severity CRITICAL --ignore-unfixed --exit-code 0 --no-progress $REGISTRY/$img:$TAG
          done
        '''
      }
    }

    stage('Push to Docker Hub') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'docker-cred',
                                          usernameVariable: 'DH_USER',
                                          passwordVariable: 'DH_PASS')]) {
          sh '''
            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
            docker push $REGISTRY/ecom-storefront:$TAG
            docker push $REGISTRY/ecom-admin-ui:$TAG
            docker logout
          '''
        }
      }
    }

    stage('Update manifest in git') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-cred',
                                          usernameVariable: 'GH_USER',
                                          passwordVariable: 'GH_PASS')]) {
          sh '''
            sed -i "s|image: $REGISTRY/ecom-storefront:.*|image: $REGISTRY/ecom-storefront:$TAG|" k8s-manifest/frontend.yaml
            sed -i "s|image: $REGISTRY/ecom-admin-ui:.*|image: $REGISTRY/ecom-admin-ui:$TAG|" k8s-manifest/frontend.yaml
            grep -n "image:" k8s-manifest/frontend.yaml

            git config user.email "jenkins@local"
            git config user.name "jenkins"
            git add k8s-manifest/frontend.yaml
            git commit -m "ci: deploy $TAG [skip ci]"
            git push https://$GH_USER:$GH_PASS@$REPO_URL HEAD:main
          '''
        }
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        sh '''
          kubectl apply -k k8s-manifest
          kubectl -n ecom rollout status deploy/storefront --timeout=300s
          kubectl -n ecom rollout status deploy/admin-ui --timeout=300s
          kubectl -n ecom get deploy storefront admin-ui -o custom-columns=NAME:.metadata.name,IMAGE:.spec.template.spec.containers[0].image
        '''
      }
    }
  }
}


